{%- comment -%}
  Product JSON-LD. Only real data: no aggregateRating/review unless a rating metafield is filled
  from a real review source (set include_rating: true when wired to a reviews app).
  Made-to-measure: variant price is per 0.01 m2, so offers express the per-m2 price with a UnitPriceSpecification.
{%- endcomment -%}
{%- liquid
  assign mtm = product.metafields.custom.made_to_measure.value
  if mtm
    assign mult = 100
  else
    assign mult = 1
  endif
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": {{ shop.url | append: product.url | append: '#product' | json }},
  "name": {{ product.title | json }},
  "url": {{ shop.url | append: product.url | json }},
  {%- if product.featured_image -%}
  "image": [{% for img in product.images limit: 6 %}{{ img | image_url: width: 1200 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}{% endfor %}],
  {%- endif %}
  "description": {{ product.description | strip_html | strip_newlines | truncate: 500 | json }},
  "brand": { "@type": "Brand", "name": {{ product.vendor | default: shop.name | json }} },
  {%- if product.selected_or_first_available_variant.sku != blank -%}"sku": {{ product.selected_or_first_available_variant.sku | json }},{%- endif %}
  {%- if product.type != blank -%}"category": {{ product.type | json }},{%- endif %}
  "offers": [
    {%- for v in product.variants -%}
    {
      "@type": "Offer",
      "url": {{ shop.url | append: v.url | json }},
      {%- if v.sku != blank -%}"sku": {{ v.sku | json }},{%- endif %}
      "name": {{ v.title | json }},
      "price": {{ v.price | times: mult | divided_by: 100.0 | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      {%- if mtm -%}
      "priceSpecification": { "@type": "UnitPriceSpecification", "price": {{ v.price | times: mult | divided_by: 100.0 | json }}, "priceCurrency": {{ cart.currency.iso_code | json }}, "referenceQuantity": { "@type": "QuantitativeValue", "value": 1, "unitCode": "MTK" } },
      {%- endif %}
      "availability": "https://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}",
      "itemCondition": "https://schema.org/NewCondition",
      "seller": { "@type": "Organization", "name": {{ shop.name | json }} }
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
  {%- if include_rating and product.metafields.reviews.rating.value != blank -%},
  "aggregateRating": { "@type": "AggregateRating", "ratingValue": {{ product.metafields.reviews.rating.value.rating | json }}, "reviewCount": {{ product.metafields.reviews.rating_count.value | json }} }
  {%- endif %}
}
</script>
