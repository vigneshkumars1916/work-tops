<section class="wt-section" style="--wt-pt: {{ section.settings.pt | divided_by: 100.0 }}; --wt-pb: {{ section.settings.pb | divided_by: 100.0 }};">
  <div class="wt-container">
    <div class="wt-ctab">
      {%- if section.settings.bg != blank -%}<div class="wt-ctab__bg" aria-hidden="true">{{ section.settings.bg | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '800, 1600', sizes: '100vw', alt: '' }}</div>{%- endif -%}
      <div class="wt-ctab__text">
        <h2 class="wt-h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      </div>
      <div class="wt-ctab__btns">
        {%- if section.settings.btn1_label != blank -%}<a class="wt-btn wt-btn--light" href="{{ section.settings.btn1_link | default: '#' }}">{{ section.settings.btn1_label }}{% render 'wt-icon', icon: 'arrow-right' %}</a>{%- endif -%}
        {%- if section.settings.btn2_label != blank -%}<a class="wt-btn wt-btn--ghost-light" href="{{ section.settings.btn2_link | default: '#' }}">{{ section.settings.btn2_label }}</a>{%- endif -%}
      </div>
    </div>
  </div>
</section>
<style>
  .wt-ctab{position:relative;overflow:hidden;display:flex;align-items:center;justify-content:space-between;gap:3.2rem;padding:clamp(3.2rem,3.6vw,4.4rem) clamp(2.4rem,3.6vw,5.6rem);background:#13221f;border-radius:var(--wt-radius);color:#fff}
  .wt-ctab__bg{position:absolute;inset:0;opacity:.35}
  .wt-ctab__bg img{width:100%;height:100%;object-fit:cover}
  .wt-ctab>*{position:relative}
  .wt-ctab>.wt-ctab__bg{position:absolute;inset:0;z-index:0}
  .wt-ctab__bg::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(15,30,27,.92),rgba(15,30,27,.75))}
  .wt-ctab .wt-h2{color:#fff}
  .wt-ctab p{margin:.8rem 0 0;color:rgba(255,255,255,.85);font-size:1.65rem}
  .wt-ctab__btns{display:flex;gap:1.4rem;flex-wrap:wrap}
  @media (max-width:899px){.wt-ctab{flex-direction:column;align-items:flex-start}}
</style>
{% schema %}
{
  "name": "WT CTA banner",
  "settings": [
    { "type": "image_picker", "id": "bg", "label": "Background texture" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready to Create Your Perfect Worktop?" },
    { "type": "text", "id": "text", "label": "Text", "default": "Get a free, no-obligation quote and expert advice from our team." },
    { "type": "text", "id": "btn1_label", "label": "Primary button", "default": "Request a Free Quote" },
    { "type": "url", "id": "btn1_link", "label": "Primary link" },
    { "type": "text", "id": "btn2_label", "label": "Secondary button", "default": "Contact Us" },
    { "type": "url", "id": "btn2_link", "label": "Secondary link" },
    { "type": "range", "id": "pt", "label": "Top spacing", "min": 0, "max": 200, "step": 5, "unit": "%", "default": 25 },
    { "type": "range", "id": "pb", "label": "Bottom spacing", "min": 0, "max": 200, "step": 5, "unit": "%", "default": 75 }
  ],
  "presets": [{ "name": "WT CTA banner" }]
}
{% endschema %}
