<section class="wt-section" style="--wt-pt: {{ section.settings.pt | divided_by: 100.0 }}; --wt-pb: {{ section.settings.pb | divided_by: 100.0 }};">
  <div class="wt-container">
    <div class="wt-ctasplit">
      <div class="wt-ctasplit__img">
        {%- if section.settings.image != blank -%}{% render 'wt-image', image: section.settings.image, sizes: '(min-width: 900px) 50vw, 100vw', widths: '480, 720, 960, 1200' %}{%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
      </div>
      <div class="wt-ctasplit__text">
        {%- if section.settings.eyebrow != blank -%}<p class="wt-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="wt-h2">{{ section.settings.heading }}</h2>
        <div class="wt-lead wt-rte">{{ section.settings.text }}</div>
        <div class="wt-ctasplit__btns">
          {%- if section.settings.btn1_label != blank -%}<a class="wt-btn" href="{{ section.settings.btn1_link | default: '#' }}">{{ section.settings.btn1_label }}{% render 'wt-icon', icon: 'arrow-right' %}</a>{%- endif -%}
          {%- if section.settings.btn2_label != blank -%}<a class="wt-btn wt-btn--outline" href="{{ section.settings.btn2_link | default: '#' }}">{{ section.settings.btn2_label }}</a>{%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  .wt-ctasplit{display:grid;grid-template-columns:1fr 1fr;background:var(--wt-surface);border-radius:var(--wt-radius);overflow:hidden;align-items:center}
  .wt-ctasplit__img{height:100%;min-height:26rem}
  .wt-ctasplit__img img,.wt-ctasplit__img svg{width:100%;height:100%;object-fit:cover;display:block}
  .wt-ctasplit__text{padding:clamp(2.8rem,4vw,5.6rem)}
  .wt-ctasplit__text .wt-lead{margin:1.4rem 0 2.8rem;font-size:1.6rem}
  .wt-ctasplit__btns{display:flex;flex-wrap:wrap;gap:1.4rem}
  @media (max-width:799px){.wt-ctasplit{grid-template-columns:1fr}.wt-ctasplit__img{aspect-ratio:16/9;min-height:0}}
</style>
{% schema %}
{
  "name": "WT Image + CTA",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Made to measure" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Need a Custom Quartz Worktop?" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Enter your exact dimensions, choose your thickness and edge profile, and get an instant price online.</p>" },
    { "type": "text", "id": "btn1_label", "label": "Primary button", "default": "Create a Custom Worktop" },
    { "type": "url", "id": "btn1_link", "label": "Primary link" },
    { "type": "text", "id": "btn2_label", "label": "Secondary button", "default": "Request a Free Quote" },
    { "type": "url", "id": "btn2_link", "label": "Secondary link" },
    { "type": "range", "id": "pt", "label": "Top spacing", "min": 0, "max": 200, "step": 5, "unit": "%", "default": 25 },
    { "type": "range", "id": "pb", "label": "Bottom spacing", "min": 0, "max": 200, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "WT Image + CTA" }]
}
{% endschema %}
