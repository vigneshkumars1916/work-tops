{%- liquid
  assign bleed = false
  if section.settings.style == 'bleed'
    assign bleed = true
  endif
-%}
<section{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %} class="wt-it{% if bleed %} wt-it--bleed{% else %} wt-section{% endif %}{% if section.settings.image_right %} wt-it--right{% endif %}" style="--wt-pt: {{ section.settings.pt | divided_by: 100.0 }}; --wt-pb: {{ section.settings.pb | divided_by: 100.0 }}; {% if section.settings.bg != blank %}background: {{ section.settings.bg }};{% endif %}">
  <div class="{% unless bleed %}wt-container {% endunless %}wt-it__grid">
    <div class="wt-it__img">
      {%- if section.settings.image != blank -%}{% render 'wt-image', image: section.settings.image, sizes: '(min-width: 900px) 50vw, 100vw', widths: '480, 720, 960, 1200, 1500' %}{%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
    </div>
    <div class="wt-it__text">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'eyebrow' -%}<p class="wt-eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
          {%- when 'heading' -%}<h2 class="wt-h2" {{ block.shopify_attributes }}>{{ block.settings.text | newline_to_br }}</h2>
          {%- when 'text' -%}<div class="wt-lead wt-rte wt-it__body" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'check' -%}<p class="wt-it__check" {{ block.shopify_attributes }}>{% render 'wt-icon', icon: 'check-circle' %}<span>{{ block.settings.text }}</span></p>
          {%- when 'button' -%}<a class="wt-btn{% if block.settings.outline %} wt-btn--outline{% endif %}" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>
<style>
  .wt-it__grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(3.2rem,4.4vw,6.4rem);align-items:center}
  .wt-it--right .wt-it__img{order:2}
  .wt-it__img{border-radius:var(--wt-radius);overflow:hidden;aspect-ratio:var(--ar,1.8/1)}
  .wt-it__img img,.wt-it__img svg{width:100%;height:100%;object-fit:cover;display:block}
  .wt-it__text>*+*{margin-top:1.8rem}
  .wt-it__text .wt-h2+.wt-it__body{margin-top:2.4rem}
  .wt-it__body{font-size:1.65rem}
  .wt-it__check{display:flex;align-items:center;gap:1.2rem;margin:1.2rem 0 0!important;color:var(--wt-text)}
  .wt-it__check .wt-icon{color:var(--wt-accent);width:2.2rem;height:2.2rem;flex-shrink:0}
  .wt-it__body+.wt-it__check{margin-top:2.4rem!important}
  .wt-it--bleed .wt-it__grid{grid-template-columns:1fr 1fr;gap:0}
  .wt-it--bleed .wt-it__img{border-radius:0;aspect-ratio:auto;min-height:42rem;height:100%}
  .wt-it--bleed .wt-it__text{padding:5.6rem max(var(--wt-gutter),calc((100vw - var(--wt-page))/2)) 5.6rem clamp(3.2rem,4.4vw,6.4rem);max-width:none}
  @media (max-width:899px){.wt-it__grid,.wt-it--bleed .wt-it__grid{grid-template-columns:1fr}.wt-it--right .wt-it__img{order:0}.wt-it--bleed .wt-it__img{min-height:0;aspect-ratio:16/10}.wt-it--bleed .wt-it__text{padding:3.2rem var(--wt-gutter)}}
</style>
{% schema %}
{
  "name": "WT Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "checkbox", "id": "image_right", "label": "Image on right", "default": false },
    { "type": "select", "id": "style", "label": "Style", "options": [{ "value": "card", "label": "Contained, rounded image" }, { "value": "bleed", "label": "Full-bleed image" }], "default": "card" },
    { "type": "color", "id": "bg", "label": "Background" },
    { "type": "text", "id": "anchor", "label": "Anchor ID (for #links)" },
    { "type": "range", "id": "pt", "label": "Top spacing", "min": 0, "max": 200, "step": 5, "unit": "%", "default": 50 },
    { "type": "range", "id": "pb", "label": "Bottom spacing", "min": 0, "max": 200, "step": 5, "unit": "%", "default": 50 }
  ],
  "blocks": [
    { "type": "eyebrow", "name": "Eyebrow", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Our story" }] },
    { "type": "heading", "name": "Heading", "settings": [{ "type": "textarea", "id": "text", "label": "Text", "default": "Crafted in Stone, Built on Trust" }] },
    { "type": "text", "name": "Text", "settings": [{ "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell your story.</p>" }] },
    { "type": "check", "name": "Checklist item", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Expert craftsmanship" }] },
    { "type": "button", "name": "Button", "settings": [{ "type": "text", "id": "label", "label": "Label", "default": "Learn more" }, { "type": "url", "id": "link", "label": "Link" }, { "type": "checkbox", "id": "outline", "label": "Outline style", "default": false }] }
  ],
  "presets": [{ "name": "WT Image with text", "blocks": [{ "type": "eyebrow" }, { "type": "heading" }, { "type": "text" }] }]
}
{% endschema %}
