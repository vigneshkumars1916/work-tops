{{ 'wt-home.css' | asset_url | stylesheet_tag }}
{{ 'wt-carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'wt-carousel.js' | asset_url }}" defer></script>
{%- assign b = section.settings.blog -%}
<section class="wt-section" style="--wt-pt: {{ section.settings.pt | divided_by: 100.0 }}; --wt-pb: {{ section.settings.pb | divided_by: 100.0 }};">
  <div class="wt-container">
    {% render 'wt-section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, link_label: section.settings.link_label, link_url: b.url %}
    <wt-carousel class="wt-blog" style="--nav-top: 18%">
    <ul class="wt-car__track wt-blog__grid" data-track role="list" tabindex="0" aria-label="{{ section.settings.heading | escape }}">
      {%- for article in b.articles limit: section.settings.count -%}
        <li><a class="wt-blog__card" href="{{ article.url }}">
          <div class="wt-blog__img">
            {%- if article.image -%}{% render 'wt-image', image: article.image, sizes: '(min-width: 990px) 24vw, (min-width: 541px) 46vw, 92vw', widths: '320, 480, 640, 800', alt: '' %}{%- else -%}{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
          </div>
          <h3 class="wt-blog__title">{{ article.title }}</h3>
        </a></li>
      {%- else -%}
        {%- for i in (1..4) -%}<li class="wt-blog__card"><div class="wt-blog__img">{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}</div><h3 class="wt-blog__title">Article title</h3></li>{%- endfor -%}
      {%- endfor -%}
    </ul>
    <div class="wt-car__nav">
      <button type="button" class="wt-car__btn" data-prev aria-label="Previous articles">{% render 'wt-icon', icon: 'chevron-left' %}</button>
      <button type="button" class="wt-car__btn" data-next aria-label="Next articles">{% render 'wt-icon', icon: 'chevron-right' %}</button>
    </div>
    </wt-carousel>
  </div>
</section>
{% schema %}
{
  "name": "WT Blog carousel",
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "count", "label": "Posts", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Inspiration & guides" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ideas for Your Next Project" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View All Articles" },
    { "type": "range", "id": "pt", "label": "Top spacing", "min": 0, "max": 200, "step": 5, "unit": "%", "default": 75 },
    { "type": "range", "id": "pb", "label": "Bottom spacing", "min": 0, "max": 200, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "WT Blog posts" }]
}
{% endschema %}
