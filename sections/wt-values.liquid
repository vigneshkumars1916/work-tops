<section class="wt-section" style="--wt-pt: {{ section.settings.pt | divided_by: 100.0 }}; --wt-pb: {{ section.settings.pb | divided_by: 100.0 }};">
  <div class="wt-container">
    <div class="wt-values__head">
      <h2 class="wt-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="wt-lead">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    <ul class="wt-values" role="list">
      {%- for f in section.settings.values -%}
        <li>{% render 'wt-icon', icon: f.icon.value %}<h3>{{ f.title.value }}</h3>{%- if f.text.value != blank -%}<p>{{ f.text.value }}</p>{%- endif -%}</li>
      {%- endfor -%}
    </ul>
  </div>
</section>
<style>
  .wt-values__head{text-align:center;margin-bottom:3.6rem}
  .wt-values__head .wt-lead{margin-top:1rem;font-size:1.6rem}
  .wt-values{display:grid;grid-template-columns:repeat({{ section.settings.values.count | at_least: 1 }},minmax(0,1fr));list-style:none;margin:0;padding:0}
  .wt-values li{text-align:center;padding:0 2.4rem;display:grid;justify-items:center;gap:1rem;align-content:start}
  .wt-values li+li{border-left:1px solid var(--wt-line)}
  .wt-values .wt-icon{width:3.6rem;height:3.6rem;color:var(--wt-ink)}
  .wt-values h3{font:600 1.85rem/1.3 var(--wt-sans);color:var(--wt-ink);margin:.4rem 0 0}
  .wt-values p{margin:0;font-size:1.45rem;color:var(--wt-text);max-width:26rem}
  @media (max-width:899px){.wt-values{grid-template-columns:repeat(2,minmax(0,1fr));row-gap:3.2rem}.wt-values li:nth-child(odd){border-left:0}}
  @media (max-width:480px){.wt-values{grid-template-columns:1fr}.wt-values li+li{border-left:0}}
</style>
{% schema %}
{
  "name": "WT Values",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Values" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "The principles that guide everything we do." },
    { "type": "metaobject_list", "id": "values", "label": "Values", "metaobject_type": "feature", "limit": 6 },
    { "type": "range", "id": "pt", "label": "Top spacing", "min": 0, "max": 200, "step": 5, "unit": "%", "default": 25 },
    { "type": "range", "id": "pb", "label": "Bottom spacing", "min": 0, "max": 200, "step": 5, "unit": "%", "default": 75 }
  ],
  "presets": [{ "name": "WT Values" }]
}
{% endschema %}
