{{ 'wt-product.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign items = product.metafields.custom.complementary.value
  if items == blank and section.settings.collection != blank
    assign items = section.settings.collection.products
  endif
-%}
{%- if items != blank -%}
<section class="wt-section" style="--wt-pt: {{ section.settings.pt | divided_by: 100.0 }}; --wt-pb: {{ section.settings.pb | divided_by: 100.0 }}; border-top:1px solid var(--wt-line)">
  <div class="wt-container">
    {% render 'wt-section-head', heading: section.settings.heading, link_label: section.settings.link_label, link_url: section.settings.link_url %}
    <ul class="wt-cyp__grid" role="list" style="list-style:none;margin:0;padding:0">
      {%- for p in items limit: 4 -%}
        {%- assign pv = p.selected_or_first_available_variant -%}
        <li class="wt-cyp__card">
          <div class="wt-cyp__img">{%- if p.featured_image -%}{% render 'wt-image', image: p.featured_image, sizes: '(min-width: 990px) 23vw, (min-width: 600px) 46vw, 92vw', widths: '320, 480, 640', alt: '' %}{%- else -%}{{ 'product-2' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}</div>
          <div class="wt-cyp__body">
            <div>
              <h3 class="wt-cyp__title"><a href="{{ p.url }}">{{ p.title }}</a></h3>
              <p class="wt-cyp__price">{% render 'wt-price', product: p, prefix: true %}</p>
            </div>
            {%- if p.has_only_default_variant and pv.available and p.metafields.custom.made_to_measure.value != true -%}
              <button type="button" class="wt-cyp__add" data-wt-quick-add="{{ pv.id }}" aria-label="Add {{ p.title | escape }} to cart"><span aria-hidden="true" style="font-size:2.2rem;line-height:1">+</span></button>
            {%- else -%}
              <a class="wt-cyp__add" href="{{ p.url }}" aria-label="Choose options for {{ p.title | escape }}"><span aria-hidden="true" style="font-size:2.2rem;line-height:1">+</span></a>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "WT Complete your project",
  "settings": [
    { "type": "paragraph", "content": "Shows the product's 'Complete your project' metafield. Falls back to the collection below." },
    { "type": "collection", "id": "collection", "label": "Fallback collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete Your Project" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View All Accessories" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "range", "id": "pt", "label": "Top spacing", "min": 0, "max": 200, "step": 5, "unit": "%", "default": 50 },
    { "type": "range", "id": "pb", "label": "Bottom spacing", "min": 0, "max": 200, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "WT Complete your project" }]
}
{% endschema %}
