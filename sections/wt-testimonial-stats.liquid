{{ 'wt-home.css' | asset_url | stylesheet_tag }}
{%- assign t = section.settings.testimonial -%}
<section class="wt-ts" aria-label="{{ section.settings.aria_label | escape }}">
  <div class="wt-ts__bg" aria-hidden="true">
    {%- if section.settings.bg != blank -%}{{ section.settings.bg | image_url: width: 1920 | image_tag: loading: 'lazy', widths: '750, 1200, 1920', sizes: '100vw', alt: '' }}{%- endif -%}
  </div>
  <div class="wt-container wt-ts__inner">
    {%- if t != blank -%}
      <figure class="wt-ts__quote" style="margin:0">
        {% render 'wt-icon', icon: 'quote' %}
        <div>
          <blockquote class="wt-ts__q" style="margin:0">&ldquo;{{ t.quote.value }}&rdquo;</blockquote>
          <figcaption class="wt-ts__by">&mdash; {{ t.author.value }}
            {%- if t.rating.value != blank -%}
              <span class="wt-stars" role="img" aria-label="{{ t.rating.value }} out of 5 stars">{% for i in (1..t.rating.value) %}{% render 'wt-icon', icon: 'star' %}{% endfor %}</span>
            {%- endif -%}
          </figcaption>
        </div>
      </figure>
    {%- else -%}
      <p>Select a testimonial (metaobject) in the theme editor.</p>
    {%- endif -%}
    <ul class="wt-ts__stats">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}><span class="wt-ts__num">{{ block.settings.number }}</span><span class="wt-ts__lbl">{{ block.settings.label }}</span></li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{% schema %}
{
  "name": "WT Testimonial + stats",
  "settings": [
    { "type": "metaobject", "id": "testimonial", "label": "Testimonial", "metaobject_type": "testimonial" },
    { "type": "image_picker", "id": "bg", "label": "Background texture" },
    { "type": "text", "id": "aria_label", "label": "Accessible label", "default": "What our customers say" }
  ],
  "blocks": [
    { "type": "stat", "name": "Stat", "settings": [
      { "type": "text", "id": "number", "label": "Number", "default": "1,200+" },
      { "type": "text", "id": "label", "label": "Label", "default": "Happy Customers" }
    ] }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "WT Testimonial + stats", "blocks": [{ "type": "stat" }] }]
}
{% endschema %}
