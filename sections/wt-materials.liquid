{{ 'wt-home.css' | asset_url | stylesheet_tag }}
<section class="wt-section" style="--wt-pt: {{ section.settings.pt | divided_by: 100.0 }}; --wt-pb: {{ section.settings.pb | divided_by: 100.0 }};">
  <div class="wt-container">
    {% render 'wt-section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, link_label: section.settings.link_label, link_url: section.settings.link_url %}
    <div class="wt-mat__grid" style="--cols: {{ section.blocks.size | at_most: 6 | at_least: 1 }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          assign img = block.settings.image | default: c.image
          assign label = block.settings.label | default: c.title
        -%}
        <a class="wt-mat__card" href="{{ c.url | default: '#' }}" {{ block.shopify_attributes }}>
          <div class="wt-mat__img">
            {%- if img != blank -%}{% render 'wt-image', image: img, sizes: '(min-width: 990px) 16vw, (min-width: 600px) 30vw, 42vw', widths: '240, 360, 480, 640' %}{%- else -%}{{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
          </div>
          <span class="wt-mat__label">{{ label | default: 'Material' }}{% render 'wt-icon', icon: 'arrow-right' %}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "WT Shop by material",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Explore our range" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Material" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View All Materials" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "range", "id": "pt", "label": "Top spacing", "min": 0, "max": 200, "step": 5, "unit": "%", "default": 75 },
    { "type": "range", "id": "pb", "label": "Bottom spacing", "min": 0, "max": 200, "step": 5, "unit": "%", "default": 50 }
  ],
  "blocks": [
    { "type": "material", "name": "Material", "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "text", "id": "label", "label": "Label override" },
      { "type": "image_picker", "id": "image", "label": "Image override" }
    ] }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "WT Shop by material", "blocks": [{ "type": "material" }, { "type": "material" }, { "type": "material" }] }]
}
{% endschema %}
